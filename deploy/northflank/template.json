{
  "apiVersion": "v1.2",
  "name": "AcademicFlow",
  "description": "AcademicFlow API + SPA + managed PostgreSQL on Northflank",
  "options": {
    "autorun": false,
    "concurrencyPolicy": "forbid"
  },
  "args": {
    "GIT_REPO_URL": "https://github.com/semedo-nob/academicflow-frontend.git",
    "GIT_BRANCH": "main",
    "CLERK_SECRET_KEY": "",
    "CLERK_ISSUER": "",
    "VITE_CLERK_PUBLISHABLE_KEY": "",
    "RESEND_API_KEY": "",
    "EMAIL_FROM": "AcademicFlow <noreply@example.com>",
    "SUPER_ADMIN_EMAIL": "nsemedo@gmail.com",
    "SUPER_ADMIN_NAME": "Nelson Semedo"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "academicflow",
            "description": "AcademicFlow production",
            "region": "europe-west",
            "networking": {
              "allowedIngressProjects": []
            }
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "database",
                "spec": {
                  "name": "academicflow-db",
                  "description": "AcademicFlow PostgreSQL",
                  "type": "postgresql",
                  "version": "16-latest",
                  "billing": {
                    "deploymentPlan": "nf-compute-50",
                    "storage": 5120,
                    "replicas": 1
                  },
                  "tlsEnabled": true,
                  "externalAccessEnabled": false
                }
              },
              {
                "kind": "CombinedService",
                "ref": "api",
                "spec": {
                  "name": "academicflow-api",
                  "description": "Spring Boot API",
                  "billing": {
                    "deploymentPlan": "nf-compute-100"
                  },
                  "deployment": {
                    "instances": 1,
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 2048
                      },
                      "shmSize": 64
                    }
                  },
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "${args.GIT_REPO_URL}",
                    "projectBranch": "${args.GIT_BRANCH}"
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 8081,
                      "protocol": "HTTP",
                      "public": true,
                      "security": {
                        "policies": [],
                        "credentials": []
                      }
                    }
                  ],
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "kaniko",
                      "useCache": true,
                      "dockerWorkDir": "/backend",
                      "dockerFilePath": "/backend/Dockerfile"
                    }
                  }
                }
              },
              {
                "kind": "CombinedService",
                "ref": "web",
                "spec": {
                  "name": "academicflow-web",
                  "description": "React SPA (nginx)",
                  "billing": {
                    "deploymentPlan": "nf-compute-20"
                  },
                  "deployment": {
                    "instances": 1,
                    "storage": {
                      "ephemeralStorage": {
                        "storageSize": 1024
                      },
                      "shmSize": 64
                    }
                  },
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "${args.GIT_REPO_URL}",
                    "projectBranch": "${args.GIT_BRANCH}"
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 80,
                      "protocol": "HTTP",
                      "public": true,
                      "security": {
                        "policies": [],
                        "credentials": []
                      }
                    }
                  ],
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "kaniko",
                      "useCache": true,
                      "dockerWorkDir": "/frontend",
                      "dockerFilePath": "/frontend/Dockerfile"
                    },
                    "buildArguments": {
                      "VITE_API_BASE_URL": "https://${refs.api.ports.0.dns}/api",
                      "VITE_CLERK_PUBLISHABLE_KEY": "${args.VITE_CLERK_PUBLISHABLE_KEY}"
                    }
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "api-secrets",
                "spec": {
                  "name": "academicflow-api-env",
                  "type": "secret",
                  "secretType": "environment-arguments",
                  "priority": 10,
                  "secrets": {
                    "variables": {
                      "SPRING_PROFILES_ACTIVE": "prod",
                      "AUTH_MODE": "clerk",
                      "SERVER_PORT": "8081",
                      "EMAIL_PROVIDER": "resend",
                      "EMAIL_FROM": "${args.EMAIL_FROM}",
                      "RESEND_API_KEY": "${args.RESEND_API_KEY}",
                      "CLERK_SECRET_KEY": "${args.CLERK_SECRET_KEY}",
                      "CLERK_ISSUER": "${args.CLERK_ISSUER}",
                      "APP_BASE_URL": "https://${refs.web.ports.0.dns}",
                      "CORS_ALLOWED_ORIGINS": "https://${refs.web.ports.0.dns}",
                      "SUPER_ADMIN_EMAIL": "${args.SUPER_ADMIN_EMAIL}",
                      "SUPER_ADMIN_NAME": "${args.SUPER_ADMIN_NAME}",
                      "INVITATION_EXPIRY_HOURS": "336"
                    },
                    "files": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.database.id}",
                      "keys": [
                        { "keyName": "HOST", "aliases": ["DB_HOST"] },
                        { "keyName": "PORT", "aliases": ["DB_PORT"] },
                        { "keyName": "DATABASE", "aliases": ["DB_NAME"] },
                        { "keyName": "USERNAME", "aliases": ["DB_USERNAME"] },
                        { "keyName": "PASSWORD", "aliases": ["DB_PASSWORD"] }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
