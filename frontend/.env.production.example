# Vercel / production SPA build (Vite).
# Set these in the Vercel project env (Production), or copy to frontend/.env.production locally for builds.
# Never commit real keys. Do not invent the API hostname — use your real Nginx/TLS URL once it exists.

# Must include the /api suffix (Spring controllers are under /api).
# Example shape only: https://api.example.com/api
VITE_API_BASE_URL=

# Clerk publishable key only (pk_…). Never put CLERK_SECRET_KEY here.
VITE_CLERK_PUBLISHABLE_KEY=
