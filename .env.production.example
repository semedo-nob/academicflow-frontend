# Production secrets for Oracle Cloud compose (docker-compose.production.yml).
# Copy:  cp .env.production.example .env
# Edit:  nano .env
# Never commit .env. Placeholders only — fill with real values on the VM.

# --- Spring / profile ---
SPRING_PROFILES_ACTIVE=prod
AUTH_MODE=clerk

# --- PostgreSQL (service name inside compose is `postgres`) ---
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- Clerk (backend) ---
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_API_BASE=https://api.clerk.com

# --- Public frontend origin (Vercel). Must be https://… — not localhost ---
# Used for CORS allowlist and invite links (APP_BASE_URL).
CORS_ALLOWED_ORIGINS=
APP_BASE_URL=

# --- Optional bootstrap (Clerk email; password lives only in Clerk) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Admin
INVITATION_EXPIRY_HOURS=336

# --- Email (production: use resend or postal, not console) ---
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
POSTAL_API_URL=
POSTAL_API_KEY=

# --- Optional / legacy property binding ---
JWT_SECRET=
