# Copy to `.env` for local tooling. Never commit `.env`.

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8081/api
# Clerk (publishable only — never put the secret key in Vite)
VITE_CLERK_PUBLISHABLE_KEY=

# Backend
SPRING_PROFILES_ACTIVE=dev
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=academicflow
DB_USERNAME=academicflow
DB_PASSWORD=academicflow
JWT_SECRET=replace-with-long-random-secret
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_BASE_URL=http://127.0.0.1:5173
INVITATION_EXPIRY_HOURS=336

# Auth — Clerk = who; AcademicFlow DB = what (roles/memberships)
# AUTH_MODE: auto (dev default — Clerk if configured, else legacy) | clerk | legacy
# Production (SPRING_PROFILES_ACTIVE=prod) REQUIRES AUTH_MODE=clerk and refuses auto/legacy.
AUTH_MODE=auto
CLERK_SECRET_KEY=
CLERK_ISSUER=
# Optional override; default derived from CLERK_ISSUER + /.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_API_BASE=https://api.clerk.com

# Optional bootstrap: AcademicFlow SUPER_ADMIN row (sign-in password lives in Clerk only — never commit it)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Admin

# Email delivery — provider-agnostic (console | resend | postal)
# console: logs messages locally (default for development; blocked on production profiles)
# Production: EMAIL_PROVIDER=resend (or postal) with real keys — never fake success.
EMAIL_PROVIDER=console
EMAIL_FROM=AcademicFlow <noreply@example.com>

# Resend (https://resend.com) — set EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Self-hosted Postal — set EMAIL_PROVIDER=postal
POSTAL_API_URL=
POSTAL_API_KEY=
